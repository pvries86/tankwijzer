# Copy to .env and adjust. Never commit a real .env.
# All values are optional; defaults are shown.

# --- Docker Compose ---
# Host port for the web UI
# HOST_PORT=8080
# Use the published image instead of building locally (then: docker compose pull && docker compose up -d --no-build)
# TANKWIJZER_IMAGE=ghcr.io/<github-user>/tankwijzer:latest

# --- Identification (strongly recommended for public OSM services) ---
# Contact address sent in the User-Agent / Nominatim "email" parameter.
CONTACT_EMAIL=
# HTTP_USER_AGENT=tankwijzer/0.2 (self-hosted; you@example.org)
# HTTP_TIMEOUT_MS=15000        # default timeout for outgoing requests (providers may override)

# --- Stations ---
# anwb = ANWB Onderweg stations incl. per-station prices (falls back to OpenStreetMap/Overpass
#        automatically when ANWB is off, paused, blocked or failing); overpass = OSM stations only
# STATION_PROVIDER=anwb
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
# STATION_CACHE_TTL_S=86400
# SEARCH_RADIUS_KM=20
# MAX_STATIONS_PER_COUNTRY=0       # 0 = all eligible stations within the radius; positive = optional per-country cap

# --- Prices ---
# Order matters: station-specific first, then country reference prices.
# PRICE_PROVIDERS=carbu,anwb,directlease,cbs-nl,fod-be   # carbu/anwb/directlease stay inactive without their *_PRIVATE_USE_ACK
# PRICE_CACHE_TTL_S=10800
# CBS_URL=https://opendata.cbs.nl/ODataApi/odata/80416ned/TypedDataSet
# FOD_PDF_URL=https://economie.fgov.be/sites/default/files/Files/Energy/prices/Officiele-Maximumtarieven-aardolieproducten.pdf

# --- ANWB Onderweg per-station prices (see README "ANWB Onderweg") ---
# OFF by default. Every ANWB response states that its content may not be copied or reproduced without
# ANWB's prior written approval. Set to true ONLY for one private, local installation for which you
# yourself hold ANWB's written approval (keep it on file). No redistribution, no public hosting.
ANWB_PRIVATE_USE_ACK=false
# ANWB_URL=https://api.anwb.nl/routing/points-of-interest/v3/all
# ANWB_PAUSED=false                 # true = no ANWB requests at all
# ANWB_DATA_DIR=data/anwb           # tile cache, request log, blocked.json (compose: /app/data/anwb volume)
# ANWB_CACHE_TTL_H=3                # an area tile is re-fetched at most once per TTL (clamped 1-24 h)
# ANWB_STALE_AFTER_H=12             # older cached prices are marked "retrieved earlier"
# ANWB_MAX_AGE_H=24                 # older cached prices are never used (max 48)
# ANWB_MIN_INTERVAL_MS=2000         # global minimum gap between ANWB requests (>= 1000)
# ANWB_HOURLY_BUDGET=30
# ANWB_DAILY_BUDGET=150
# ANWB_MAX_TILES_PER_SEARCH=6       # area tiles (0.5 deg x 0.75 deg) fetched per search at most
# ANWB_TILE_LAT_DEG=0.5
# ANWB_TILE_LON_DEG=0.75
# ANWB_ERROR_BACKOFF_MIN=30         # pause after a network/server error (429 => >= 6 h, 401/403 => permanent)
# ANWB_TIMEOUT_MS=20000
# ANWB_USER_AGENT=tankwijzer/0.2 (private self-hosted instance, personal use; ANWB Onderweg fuel prices; you@example.org)

# --- CARBU.COM per-station prices, Belgium (see README "CARBU.COM") ---
# OFF by default. Set to true ONLY for one private, local installation for which you yourself hold
# CARBU.COM's written permission for automated retrieval and local caching (keep it on file).
# No redistribution, no public hosting, no organisational use. Other users need their own permission.
CARBU_PRIVATE_USE_ACK=false
# CARBU_BASE_URL=https://carbu.com
# CARBU_PAUSED=false                # true = no CARBU.COM requests at all
# CARBU_DATA_DIR=data/carbu         # list/location cache, request log, blocked.json (compose: /app/data/carbu volume)
# CARBU_CACHE_TTL_H=3               # a station list (place + fuel) is re-fetched at most once per TTL (1-24 h)
# CARBU_STALE_AFTER_H=12            # older cached lists are marked "retrieved earlier"
# CARBU_MAX_AGE_H=24                # older cached lists are never used (max 48)
# CARBU_LOCATION_TTL_D=30           # postal code -> CARBU place id cache
# CARBU_MAX_LOCATIONS_PER_SEARCH=2  # station lists fetched per search at most
# CARBU_COVER_KM=20                 # one list is assumed to cover candidate stations within this distance
# CARBU_MATCH_RADIUS_M=200          # CARBU station must be this close to a candidate station to use its price
# CARBU_PRICE_STALE_DAYS=7          # older CARBU price dates are marked "stale"
# CARBU_PRICE_MAX_DAYS=30           # older CARBU price dates are not used
# CARBU_MIN_INTERVAL_MS=1500        # global minimum gap between CARBU.COM requests (>= 1000)
# CARBU_HOURLY_BUDGET=20
# CARBU_DAILY_BUDGET=100
# CARBU_ERROR_BACKOFF_MIN=30        # pause after network/server/parse errors (429 => >= 6 h, 401/403 => permanent)
# CARBU_TIMEOUT_MS=30000
# CARBU_REFERER=https://carbu.com/  # empty = send no Referer
# CARBU_USER_AGENT=tankwijzer/0.3 (private self-hosted instance, personal use with permission; CARBU.COM fuel prices; you@example.org)

# --- DirectLease per-station prices (optional sidecar; see README "DirectLease") ---
# OFF by default. Set to true ONLY for one private, local installation for which you yourself hold
# App It Up BV's permission. Also start the sidecar: docker compose --profile directlease up -d
DIRECTLEASE_PRIVATE_USE_ACK=false
# DIRECTLEASE_PAUSED=false                   # true = no DirectLease requests at all
# DIRECTLEASE_URL=http://127.0.0.1:8090       # docker-compose sets http://directlease:8090
# DIRECTLEASE_TIMEOUT_MS=60000
# DIRECTLEASE_MAX_AGE_H=36                    # older quotes are ignored (country estimate used instead)
# Sidecar throttling (read by docker-compose for the directlease service):
# DIRECTLEASE_CACHE_TTL_H=24                  # minimum 24; a station is re-fetched at most once per TTL
# DIRECTLEASE_DAILY_BUDGET=200                # max upstream requests per UTC day
# DIRECTLEASE_MAX_FETCH_PER_REQUEST=15
# DIRECTLEASE_MIN_INTERVAL_S=1.5
# DIRECTLEASE_LOG_LEVEL=INFO

# --- Routing / geocoding ---
# ROUTING_PROVIDER=osrm        # osrm | estimate
# OSRM_URL=https://router.project-osrm.org   # public demo server; self-host for real use
# ROAD_FACTOR=1.3
# GEOCODER=photon              # photon (search-as-you-type, default) | nominatim | none
# PHOTON_URL=https://photon.komoot.io        # public fair-use instance; self-host for heavier use
# LOCAL_PLACES=true            # instant offline town/postcode suggestions (GeoNames, data/places.tsv)
# OFFICIAL_GEOCODERS=pdok,vlaanderen   # fast NL (PDOK, CC0) and Flanders/Brussels address search; empty = off
# PDOK_URL=https://api.pdok.nl/bzk/locatieserver/search/v3_1
# VLAANDEREN_GEO_URL=https://geo.api.vlaanderen.be/geolocation/v4
# NOMINATIM_URL=https://nominatim.openstreetmap.org   # Nominatim has no prefix matching and its policy forbids autocomplete
# Default: the European countries ANWB Onderweg covers (nl,be,de,lu,fr,at,ch,...). Narrow it, e.g.:
# GEOCODE_COUNTRIES=nl,be,de

# --- Map tiles ---
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# --- Kenteken (Dutch licence plate) lookup via RDW Open Data (CC0) ---
# KENTEKEN_LOOKUP=true          # false hides the field and disables /api/kenteken
# RDW_URL=https://opendata.rdw.nl
# RDW_APP_TOKEN=                # optional Socrata app token; stays server-side
# VEHICLE_REALISM_UPLIFT_PCT=15 # default "+x% realism" on WLTP/NEDC lab consumption (user can switch off)

# --- Misc ---
# MIN_WORTHWHILE_SAVING_EUR=1.0
# RATE_LIMIT_PER_MIN=30
# APP_BUILD=                   # build label in the footer (Docker/CI sets date + commit); empty = newest public/ file date
